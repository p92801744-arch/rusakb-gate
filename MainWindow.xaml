<Window x:Class="RusakbGate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RusakbGate" Height="480" Width="440"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Fg}"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        ShowInTaskbar="True" Topmost="False"
        FontFamily="Segoe UI">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource Bg1}" Padding="24,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="RusakbGate" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border x:Name="StatusPill" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource Bg2}" CornerRadius="12" Padding="12,6">
                    <TextBlock x:Name="StatusPillText" Text="ВЫКЛ" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Muted}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <Border Width="168" Height="168" CornerRadius="84" Background="{StaticResource Bg2}"
                    BorderBrush="#2a3144" BorderThickness="2">
                <ToggleButton x:Name="PowerToggle" Width="152" Height="152"
                              Checked="PowerToggle_OnChecked" Unchecked="PowerToggle_OnUnchecked"
                              Cursor="Hand">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Ring" CornerRadius="76" Background="{StaticResource Off}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse Width="12" Height="12" x:Name="Dot" Fill="#8891a8" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="Lbl" Text="ВКЛ" FontSize="22" FontWeight="Bold"
                                               Foreground="#eef1f8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Ring" Property="Background" Value="{StaticResource Ok}"/>
                                    <Setter TargetName="Lbl" Property="Text" Value="ВКЛ"/>
                                    <Setter TargetName="Lbl" Property="Foreground" Value="#0b1a10"/>
                                    <Setter TargetName="Dot" Property="Fill" Value="#0b1a10"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="Lbl" Property="Text" Value="ВЫКЛ"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Ring" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Border>
            <TextBlock x:Name="ServerLine" Margin="0,20,0,0" HorizontalAlignment="Center"
                       Foreground="{StaticResource Muted}" FontSize="13" TextAlignment="Center"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource Bg1}" Padding="20,16">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource Fg}" FontSize="13" LineHeight="20"/>
                <StackPanel x:Name="MainActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Content="Проверка IP" Click="CheckIp_Click" Padding="18,10" Margin="0,0,8,0"
                            Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Открыть лог" Click="OpenLog_Click" Padding="18,10"
                            Background="{StaticResource Bg2}" Foreground="{StaticResource Fg}"
                            BorderBrush="#3a4154" BorderThickness="1" Cursor="Hand"/>
                </StackPanel>
                <Button x:Name="BackButton" Content="Назад" Click="Back_Click" Visibility="Collapsed"
                        HorizontalAlignment="Center" Margin="0,14,0,0" Padding="28,10"
                        Background="{StaticResource Bg2}" Foreground="{StaticResource Fg}"
                        BorderBrush="#3a4154" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
